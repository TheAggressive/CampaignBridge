{
  "name": "campaignbridge",
  "version": "1.0.2",
  "description": "Enterprise WordPress email campaign management with dynamic content and provider integrations.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.1.2",
  "main": "index.js",
  "scripts": {
    "// VERSION MANAGEMENT": "_",
    "version:sync": "node -e \"import fs from 'fs'; const pkg = JSON.parse(fs.readFileSync('package.json')); let content = fs.readFileSync('campaignbridge.php', 'utf8'); content = content.replace(/\\\\* Version: [0-9]+\\\\.[0-9]+\\\\.[0-9]+/, '* Version: ' + pkg.version); content = content.replace(/public const VERSION = '[0-9]+\\\\.[0-9]+\\\\.[0-9]+'/, 'public const VERSION = \\'' + pkg.version + '\\''); fs.writeFileSync('campaignbridge.php', content); console.log('Synced version:', pkg.version);\"",
    "preversion": "pnpm version:sync",
    "// BLOCK DEVELOPMENT": "_",
    "create-block": "npx @wordpress/create-block@latest --no-plugin --namespace campaignbridge",
    "create-block-dynamic": "npx @wordpress/create-block@latest --no-plugin --namespace campaignbridge --variant dynamic",
    "// BUILD SCRIPTS": "_",
    "build:blocks": "wp-scripts build --config webpack.config.mjs --source-path=./src/blocks --output-path=./dist/blocks",
    "build:assets": "wp-scripts build --config webpack.assets.config.mjs",
    "clean": "node bin/clean.mjs",
    "build": "pnpm version:sync && pnpm clean && concurrently 'pnpm build:blocks' 'pnpm build:assets'",
    "// DEVELOPMENT SERVERS": "_",
    "start:blocks": "wp-scripts start --config webpack.config.js --source-path=./src/blocks --output-path=./dist/blocks",
    "start:assets": "wp-scripts start --config webpack.assets.config.js",
    "start": "concurrently 'pnpm start:blocks' 'pnpm start:assets'",
    "start:hot": "wp-scripts start --output-path=./dist --hot",
    "start:copy-php": "wp-scripts start --output-path=./dist --webpack-copy-php",
    "js:watch": "wp-scripts start ./src/scripts/app.js --output-path=dist/scripts",
    "// CODE QUALITY": "_",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,json,css,md}'",
    "format:check": "prettier --check 'src/**/*.{js,jsx,ts,tsx,json,css,md}'",
    "lint:js": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint ./src/**/*.{js,jsx,ts,tsx} --fix",
    "fix:all": "pnpm lint:php:fix && pnpm lint:fix && pnpm format",
    "lint:php": "./vendor/bin/phpcs --standard=phpcs.xml.dist includes/ src/ campaignbridge.php uninstall.php",
    "lint:php:fix": "./vendor/bin/phpcbf --standard=phpcs.xml.dist includes/ src/ campaignbridge.php uninstall.php",
    "phpstan": "./vendor/bin/phpstan analyse --memory-limit=2G --verbose",
    "security:check": "composer audit --locked --no-interaction && pnpm audit --prod --audit-level moderate",
    "composer:verify": "composer validate --strict --no-check-publish && composer install --dry-run --no-interaction --no-scripts",
    "lint:actions": "bash bin/ci/check-action-pins.sh",
    "lint:boundaries": "bash bin/ci/check-repository-boundary.sh",
    "lint:files": "bash bin/ci/check-file-length.sh && node bin/ci/check-dependency-sources.mjs && pnpm test:tools && pnpm lint:actions && pnpm lint:boundaries",
    "qa": "pnpm composer:verify && pnpm lint:files && pnpm lint:php && pnpm lint:js && pnpm typecheck && pnpm format:check && pnpm phpstan && pnpm security:check && pnpm test",
    "qa:fast": "pnpm composer:verify && pnpm lint:files && pnpm lint:php && pnpm lint:js && pnpm typecheck && pnpm format:check && pnpm phpstan",
    "// TESTING": "_",
    "test:setup": "bash bin/local/test-environment.sh",
    "test:install": "composer install --dev && pnpm test:setup",
    "test": "bash bin/local/wp-tests.sh --testdox",
    "test:unit": "bash bin/local/wp-tests.sh --testsuite=unit --testdox",
    "test:integration": "bash bin/local/wp-tests.sh --testsuite=integration --testdox",
    "test:security": "bash bin/local/wp-tests.sh --testsuite=security --testdox",
    "test:accessibility": "bash bin/local/wp-tests.sh --testsuite=accessibility --testdox",
    "test:performance": "bash bin/local/wp-tests.sh --testsuite=performance --testdox",
    "test:coverage": "XDEBUG_MODE=coverage bash bin/local/wp-tests.sh --coverage-html=coverage/html --coverage-text",
    "test:any": "bash bin/local/wp-tests.sh",
    "test:tools": "node --test bin/ci/github-governance.test.mjs bin/ci/pr-policy-rules.test.mjs",
    "db:local": "bash bin/local/mysql.sh",
    "// UTILITY SCRIPTS": "_",
    "packages-update": "wp-scripts packages-update",
    "plugin-zip": "wp-scripts plugin-zip",
    "release:package": "bash bin/release/package.sh",
    "release:verify": "bash bin/release/verify-package.sh",
    "semantic-release": "semantic-release",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "Aggressive Network, LLC",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.5",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/wordpress__block-editor": "^15.0.6",
    "@typescript-eslint/parser": "^8.68.0",
    "@wordpress/annotations": "^3.54.0",
    "@wordpress/api-fetch": "^7.54.0",
    "@wordpress/block-editor": "^17.0.0",
    "@wordpress/blocks": "^15.27.0",
    "@wordpress/components": "^40.0.0",
    "@wordpress/compose": "^8.7.0",
    "@wordpress/core-data": "^7.54.0",
    "@wordpress/data": "^10.54.0",
    "@wordpress/data-controls": "^4.54.0",
    "@wordpress/dependency-extraction-webpack-plugin": "^6.54.0",
    "@wordpress/dom-ready": "^4.54.0",
    "@wordpress/editor": "^14.54.0",
    "@wordpress/element": "^8.6.0",
    "@wordpress/eslint-plugin": "^25.10.0",
    "@wordpress/hooks": "^4.54.0",
    "@wordpress/html-entities": "^4.54.0",
    "@wordpress/i18n": "^6.27.0",
    "@wordpress/icons": "^15.5.0",
    "@wordpress/interface": "^10.0.0",
    "@wordpress/keyboard-shortcuts": "^5.54.0",
    "@wordpress/keycodes": "^4.54.0",
    "@wordpress/notices": "^5.54.0",
    "@wordpress/scripts": "^34.2.0",
    "@wordpress/url": "^4.54.0",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.26",
    "postcss-lightningcss": "1.0.2",
    "postcss-nested": "7.0.2",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^18.3.1",
    "react-dom": "18.3.1",
    "sass": "^1.103.1",
    "semantic-release": "^25.0.9",
    "tailwindcss": "4.1.17",
    "typescript": "^5.9.3",
    "webpack-merge": "^6.0.1",
    "webpack-remove-empty-scripts": "^1.1.1"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "core-js",
      "core-js-pure",
      "fs-ext-extra-prebuilt",
      "unrs-resolver"
    ]
  }
}
