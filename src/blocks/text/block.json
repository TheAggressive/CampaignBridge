{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "version": "1.0.0",
  "name": "campaignbridge/text",
  "title": "Email Text",
  "category": "campaignbridge-email",
  "icon": "text",
  "description": "Portable rich text with a constrained inline-format contract.",
  "textdomain": "campaignbridge",
  "parent": ["campaignbridge/section"],
  "supports": {
    "html": false,
    "reusable": false,
    "align": ["left", "center", "right"],
    "color": {
      "text": true,
      "background": true,
      "gradients": false
    },
    "spacing": {
      "padding": true,
      "margin": true
    },
    "typography": {
      "fontSize": true,
      "fontFamily": true,
      "lineHeight": true
    },
    "customClassName": false
  },
  "attributes": {
    "content": {
      "type": "string",
      "default": ""
    },
    "align": {
      "type": "string",
      "default": "left"
    }
  },
  "editorScript": "file:./index.js"
}
