{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "version": "1.0.0",
  "name": "campaignbridge/columns",
  "title": "Email Columns",
  "category": "campaignbridge-email",
  "icon": "columns",
  "description": "Arrange up to six email-safe columns with responsive stacking.",
  "textdomain": "campaignbridge",
  "parent": ["campaignbridge/post-card", "campaignbridge/section"],
  "supports": {
    "html": false,
    "innerBlocks": true,
    "reusable": false,
    "customClassName": false,
    "spacing": {
      "blockGap": true
    },
    "layout": {
      "allowSwitching": false,
      "allowOrientation": false,
      "allowJustification": false,
      "allowVerticalAlignment": false,
      "default": {
        "type": "flex",
        "flexWrap": "nowrap"
      },
      "allowInheriting": false
    }
  },
  "attributes": {
    "verticalAlign": {
      "type": "string",
      "default": "top"
    },
    "isStackedOnMobile": {
      "type": "boolean",
      "default": true
    }
  },
  "editorScript": "file:./index.js"
}
