{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "version": "1.0.0",
  "name": "campaignbridge/post-title",
  "title": "Post Title",
  "category": "campaignbridge-email",
  "icon": "heading",
  "description": "Displays the post title with customizable typography and styling.",
  "parent": ["campaignbridge/column", "campaignbridge/post-card"],
  "supports": {
    "html": false,
    "reusable": false,
    "align": ["left", "center", "right"],
    "color": {
      "text": true,
      "background": false,
      "gradients": false
    },
    "customClassName": false,
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "attributes": {
    "level": {
      "type": "number",
      "default": 2
    },
    "align": {
      "type": "string",
      "default": "left"
    },
    "linkToPost": {
      "type": "boolean",
      "default": false
    }
  },
  "usesContext": ["campaignbridge:postId", "campaignbridge:postType"],
  "editorScript": "file:./index.js"
}
