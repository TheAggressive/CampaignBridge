{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "version": "1.0.0",
  "name": "campaignbridge/post-title",
  "title": "Post Title",
  "category": "campaignbridge-email",
  "icon": "heading",
  "description": "Displays the post title with customizable typography and styling.",
  "parent": ["campaignbridge/post-card"],
  "supports": {
    "html": false,
    "reusable": false
  },
  "attributes": {
    "level": {
      "type": "number",
      "default": 2
    },
    "align": {
      "type": "string",
      "default": "left"
    },
    "textColor": {
      "type": "string",
      "default": "#111111"
    },
    "linkToPost": {
      "type": "boolean",
      "default": false
    }
  },
  "usesContext": ["campaignbridge:postId", "campaignbridge:postType"],
  "editorScript": "file:./index.js"
}
