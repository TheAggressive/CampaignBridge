{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "version": "1.0.0",
  "name": "campaignbridge/post-button",
  "title": "Post Button",
  "category": "campaignbridge-email",
  "icon": "button",
  "description": "Creates a bulletproof button linking to the selected post.",
  "parent": ["campaignbridge/column", "campaignbridge/post-card"],
  "supports": {
    "html": false,
    "reusable": false,
    "color": { "background": true, "text": true, "link": true },
    "align": true
  },
  "attributes": {
    "label": {
      "type": "string",
      "default": "Read more"
    },
    "destination": {
      "type": "string",
      "enum": ["article", "postParent", "postTypeArchive", "custom"],
      "default": "article"
    },
    "customUrl": {
      "type": "string",
      "default": ""
    },
    "backgroundColor": {
      "type": "string",
      "default": "#111111"
    },
    "textColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "align": {
      "type": "string",
      "default": "left"
    },
    "style": {
      "type": "string",
      "default": "button"
    },
    "linkColor": {
      "type": "string",
      "default": "#111111"
    }
  },
  "usesContext": ["campaignbridge:postId", "campaignbridge:postType"],
  "editorScript": "file:./index.js"
}
