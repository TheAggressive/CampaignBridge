{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "version": "1.0.0",
  "name": "campaignbridge/container",
  "title": "Email Container",
  "category": "campaignbridge-email",
  "icon": "email",
  "description": "Root email container (centered table). Colors come from core color support; paddings are attributes.",
  "textdomain": "campaignbridge",
  "supports": {
    "multiple": false,
    "innerBlocks": true,
    "lock": true,
    "reusable": false,
    "html": false,
    "color": {
      "background": true,
      "text": true,
      "gradients": false
    },
    "spacing": {
      "padding": true,
      "margin": true
    },
    "customClassName": false,
    "layout": {
      "allowSwitching": false,
      "allowEditing": true,
      "default": {
        "type": "constrained"
      },
      "allowInheriting": false,
      "allowJustification": false
    }
  },
  "attributes": {},
  "editorScript": "file:./index.js"
}
