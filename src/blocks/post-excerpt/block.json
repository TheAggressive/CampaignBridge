{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "version": "1.0.0",
  "name": "campaignbridge/post-excerpt",
  "title": "Post Excerpt",
  "category": "campaignbridge-email",
  "icon": "editor-justify",
  "description": "Shows a bounded plain-text summary for the selected post.",
  "parent": ["campaignbridge/column", "campaignbridge/post-card"],
  "supports": {
    "html": false,
    "reusable": false,
    "align": ["left", "center", "right"],
    "color": {
      "text": true,
      "background": false,
      "gradients": false
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "customClassName": false
  },
  "attributes": {
    "maxWords": {
      "type": "number",
      "default": 50
    },
    "align": {
      "type": "string",
      "default": "left"
    }
  },
  "usesContext": ["campaignbridge:postId", "campaignbridge:postType"],
  "editorScript": "file:./index.js"
}
