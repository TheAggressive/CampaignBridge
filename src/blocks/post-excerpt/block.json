{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "version": "1.0.0",
  "name": "campaignbridge/post-excerpt",
  "title": "Post Excerpt",
  "category": "campaignbridge-email",
  "icon": "editor-justify",
  "description": "Shows a bounded plain-text summary for the selected post.",
  "parent": ["campaignbridge/column", "campaignbridge/post-card"],
  "supports": {
    "html": false,
    "reusable": false,
    "align": true,
    "color": { "text": true },
    "typography": { "fontSize": true }
  },
  "attributes": {
    "maxWords": {
      "type": "number",
      "default": 50
    },
    "align": {
      "type": "string",
      "default": "left"
    },
    "textColor": {
      "type": "string",
      "default": "#333333"
    },
    "fontSize": {
      "type": "number",
      "default": 16
    }
  },
  "usesContext": ["campaignbridge:postId", "campaignbridge:postType"],
  "editorScript": "file:./index.js"
}
