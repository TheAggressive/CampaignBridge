{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "version": "1.0.0",
  "name": "campaignbridge/post-excerpt",
  "title": "Post Excerpt",
  "category": "widgets",
  "icon": "editor-justify",
  "description": "Shows a bounded plain-text summary for the selected post.",
  "parent": ["campaignbridge/post-card"],
  "supports": { "html": false, "reusable": false },
  "attributes": {
    "maxWords": { "type": "number", "default": 50 }
  },
  "usesContext": ["campaignbridge:postId", "campaignbridge:postType"],
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css"
}
