{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "version": "1.0.0",
  "name": "campaignbridge/compliance-footer",
  "title": "Email Compliance Footer",
  "category": "campaignbridge-email",
  "icon": "shield",
  "description": "Shows the sender identity, postal address, and unsubscribe link required to send.",
  "textdomain": "campaignbridge",
  "parent": ["campaignbridge/container"],
  "supports": {
    "html": false,
    "reusable": false,
    "multiple": false,
    "align": ["left", "center", "right"],
    "color": {
      "text": true,
      "gradients": false
    },
    "customClassName": false,
    "spacing": {
      "padding": true
    }
  },
  "attributes": {
    "businessName": {
      "type": "string",
      "default": ""
    },
    "address": {
      "type": "string",
      "default": ""
    },
    "unsubscribeLabel": {
      "type": "string",
      "default": "Unsubscribe"
    }
  },
  "editorScript": "file:./index.js"
}
