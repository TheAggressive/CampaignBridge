{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "version": "1.0.0",
  "name": "campaignbridge/divider",
  "title": "Email Divider",
  "category": "campaignbridge-email",
  "icon": "minus",
  "description": "A portable horizontal divider with bounded dimensions.",
  "textdomain": "campaignbridge",
  "parent": ["campaignbridge/column", "campaignbridge/section"],
  "supports": {
    "html": false,
    "reusable": false,
    "customClassName": false,
    "__experimentalBorder": {
      "color": true,
      "width": true,
      "style": true
    }
  },
  "attributes": {
    "width": {
      "type": "number",
      "default": 100
    }
  },
  "editorScript": "file:./index.js"
}
