{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "version": "1.0.0",
  "name": "campaignbridge/button",
  "title": "Email Button",
  "category": "campaignbridge-email",
  "icon": "button",
  "description": "A bulletproof call-to-action with an Outlook VML fallback.",
  "textdomain": "campaignbridge",
  "parent": ["campaignbridge/column", "campaignbridge/section"],
  "supports": {
    "html": false,
    "reusable": false,
    "align": ["left", "center", "right"],
    "color": {
      "background": true,
      "text": true,
      "gradients": false
    },
    "typography": {
      "fontFamily": true
    },
    "customClassName": false
  },
  "attributes": {
    "label": {
      "type": "string",
      "default": "Learn more"
    },
    "url": {
      "type": "string",
      "default": ""
    },
    "align": {
      "type": "string",
      "default": "left"
    }
  },
  "styles": [
    {
      "name": "primary",
      "label": "Fill",
      "isDefault": true
    },
    {
      "name": "outline",
      "label": "Outline"
    },
    {
      "name": "ghost",
      "label": "Text link"
    }
  ],
  "editorScript": "file:./index.js"
}
