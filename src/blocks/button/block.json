{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "version": "1.0.0",
  "name": "campaignbridge/button",
  "title": "Email Button",
  "category": "campaignbridge-email",
  "icon": "button",
  "description": "A bulletproof call-to-action with an Outlook VML fallback.",
  "textdomain": "campaignbridge",
  "parent": ["campaignbridge/section"],
  "supports": {
    "html": false,
    "reusable": false,
    "align": true,
    "color": { "background": true, "text": true }
  },
  "attributes": {
    "label": { "type": "string", "default": "Learn more" },
    "url": { "type": "string", "default": "" },
    "align": { "type": "string", "default": "left" }
  },
  "styles": [
    { "name": "primary", "label": "Primary" },
    { "name": "outline", "label": "Outline" },
    { "name": "ghost", "label": "Ghost" }
  ],
  "editorScript": "file:./index.js"
}
