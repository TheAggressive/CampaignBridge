  "postBindings": {
    "$comment": "The one read-only CampaignBridge post binding source. Only these block, attribute, field, and argument combinations are accepted; every other binding fails closed in Core_Block_Normalizer. A field's `reads` names the immutable snapshot field supplying its value; an optional `link` names the snapshot field the renderer links that value to.",
    "source": "campaignbridge/post-data",
    "attributes": {
      "core/heading": {
        "content": {
          "projection": "rich-text",
          "fields": {
            "title": { "reads": "title" },
            "titleLink": { "reads": "title", "link": "url" }
          },
          "args": {}
        }
      },
      "core/paragraph": {
        "content": {
          "projection": "rich-text",
          "fields": {
            "excerpt": { "reads": "excerpt" },
            "content": { "reads": "content" }
          },
          "args": {
            "maxWords": {
              "type": "integer",
              "min": 10,
              "max": 500,
              "default": 50
            }
          }
        }
      },
      "core/button": {
        "url": {
          "projection": "url",
          "fields": {
            "url": { "reads": "url" },
            "postParentUrl": { "reads": "postParentUrl" },
            "postTypeArchiveUrl": { "reads": "postTypeArchiveUrl" }
          },
          "args": {}
        }
      }
    }
  },
  "brandBindings": {
    "$comment": "The read-only frozen Brand Kit binding source. A Core Image variation uses these mappings to project the imported logo without storing a second asset record.",
    "source": "campaignbridge/brand-data",
    "attributes": {
      "core/image": {
        "url": { "field": "logoUrl", "target": "url" },
        "alt": { "field": "logoAlt", "target": "alt" },
        "href": { "field": "logoLink", "target": "linkUrl" }
      }
    }
  }
}
